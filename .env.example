# Public Supabase connection settings. Use the anon key, never the service key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only secrets. Configure these in Vercel or .env.local.
SUPABASE_SERVICE_ROLE_KEY=
RESEND_API_KEY=
EMAIL_FROM=Next on Moms Plate <notifications@your-verified-domain.example>
APP_URL=http://localhost:3000
NOTIFICATION_SECRET=
